#!/command/with-contenv bashio
set -e

# Get config values from Home Assistant
CONFIG_PATH=/data/options.json

# Database configuration
export DB_TYPE=$(bashio::config 'db_type')
export DB_PATH=$(bashio::config 'db_path')
export DB_LOGGING=$(bashio::config 'db_logging')

# Server configuration
export PORT=$(bashio::config 'port')
export HOST=$(bashio::config 'host')

# Determine URLs based on ingress settings
INGRESS_URL=$(bashio::addon.ingress_url)
export PUBLIC_URL="${INGRESS_URL}"
export CLIENT_URL="${INGRESS_URL}"

# Get user-configured allowed origins
USER_ALLOWED_ORIGINS=$(bashio::config 'allowed_origins')

# Start with user-configured allowed origins and add ingress URL for CORS
ALLOWED_ORIGINS="${USER_ALLOWED_ORIGINS},${INGRESS_URL}"

# Add external URL if port is exposed
if [ "$(bashio::addon.port)" != "null" ]; then
    EXTERNAL_URL="http://$(bashio::addon.hostname):$(bashio::addon.port)"
    ALLOWED_ORIGINS="${ALLOWED_ORIGINS},${EXTERNAL_URL}"
fi

# Export the combined allowed origins
export ALLOWED_ORIGINS="${ALLOWED_ORIGINS}"

# Auth configuration
export LOCAL_USERS_ENABLED=$(bashio::config 'local_users_enabled')
export GITHUB_ENABLED=$(bashio::config 'github_enabled')

if bashio::config.has_value 'github_client_id' && bashio::config.has_value 'github_client_secret'; then
    export GITHUB_CLIENT_ID=$(bashio::config 'github_client_id')
    export GITHUB_CLIENT_SECRET=$(bashio::config 'github_client_secret')
fi

# Yjs data path
export DATA_PATH=$(bashio::config 'data_path')

# Ensure data directories exist
mkdir -p "$(dirname "$DB_PATH")"
mkdir -p "$DATA_PATH"

# Log configuration
bashio::log.info "Starting Inkweld with the following configuration:"
bashio::log.info "Database type: $DB_TYPE"
bashio::log.info "Port: $PORT"
bashio::log.info "Public URL: $PUBLIC_URL"
bashio::log.info "Local users enabled: $LOCAL_USERS_ENABLED"
bashio::log.info "Allowed origins: $ALLOWED_ORIGINS"
bashio::log.info "GitHub auth enabled: $GITHUB_ENABLED"
bashio::log.info "Ingress enabled on port 8099"

# Start the application
cd /app/server
exec bun dist/src/main.js